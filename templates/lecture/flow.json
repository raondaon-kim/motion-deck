   "back": "{back}",
   "x": 140,
   "y": 520,
   "w": 1640,
   "colors": [
    "$soft+2",
    "$soft+4",
    "$soft+6",
    "$soft+1",
    "$soft+3",
    "$soft+5"
   ],
