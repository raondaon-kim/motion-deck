{
 "use": "목록 3~4개 + 작은 일러스트",
 "layout": "text-left",
 "bg": "$soft",
 "slots": {
  "kicker": "text?",
  "title": "lines:1-2",
  "items": "items:3-4 (strings)",
  "art": "illustration?"
 },
 "elements": [
  {
   "type": "blob",
   "x": 1420,
   "y": 580,
   "r": 330,
   "color": "$soft+4",
